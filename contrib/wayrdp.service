# ~/.config/systemd/user/wayrdp.service
#
# wayrdp next to mwc.service (see README).
#
# It takes RDP's port 3389 (the default): xrdp and wayvnc go before it is
# installed, there is no phase next to them.
#
# Run "wayrdp --set-password" first (for -a nla, the default).
[Unit]
Description=wayrdp for mwc
BindsTo=mwc.service
After=mwc.service

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/wayrdp -k de
# mwc's socket may not be there yet when this starts.
Restart=on-failure
RestartSec=1

# FreeRDP parses what comes from the network in this process. These hold
# in a user service too (seccomp and prctl):
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# For -a pam remove this line: PAM checks the password with the setgid
# helper unix_chkpwd.
NoNewPrivileges=yes

# These need a mount namespace. A user service on Ubuntu doesn't get one
# (unprivileged user namespaces are restricted by AppArmor), and systemd
# then skips them without a word: they protect nothing there. They do
# where systemd can apply them.
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=%h/.config/wayrdp

[Install]
WantedBy=mwc.service
