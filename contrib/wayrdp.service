# ~/.config/systemd/user/wayrdp.service
#
# wayrdp next to mwc.service, on port 3390 while xrdp still has 3389.
# Once wayrdp does the job: drop the port (default 3389) and remove xrdp.
# Run "wayrdp --set-password" first: it creates ~/.config/wayrdp, which
# ReadWritePaths needs to exist.
[Unit]
Description=wayrdp for mwc
BindsTo=mwc.service
After=mwc.service

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/wayrdp -k de 127.0.0.1 3390
# mwc's socket may not be there yet when this starts.
Restart=on-failure
RestartSec=1
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=%h/.config/wayrdp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=yes

[Install]
WantedBy=mwc.service
